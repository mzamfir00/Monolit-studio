# PostgreSQL connection used by Prisma (migrations, seed, admin modules)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maison_gravure?schema=public"

# Directory for customer sketch uploads (defaults to ./.uploads)
# UPLOAD_DIR="/var/lib/maison-gravure/uploads"

# Public origin used for Stripe success / cancel URLs (falls back to the request host)
# NEXT_PUBLIC_SITE_URL="https://maison-gravure.ro"

# Stripe — card-only Checkout. Leave empty to develop with the payment simulation.
STRIPE_SECRET_KEY=""
# Signing secret of the /api/stripe/webhook endpoint (`stripe listen` prints one for local testing)
STRIPE_WEBHOOK_SECRET=""

# Development payment simulation: always on under `next dev`; set to "true" to allow it under `next start`.
# Ignored whenever STRIPE_SECRET_KEY is a live key.
# PAYMENT_SIMULATION="true"
