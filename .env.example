# PostgreSQL connection used by Prisma (migrations, seed, admin modules)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maison_gravure?schema=public"
# Direct (non-pooled) connection for migrations and the seed, when DATABASE_URL goes through a pooler (Neon sets both)
# DATABASE_URL_UNPOOLED=""

# Public origin: canonical URLs, sitemap, share images and Stripe success / cancel URLs.
# Falls back to the Vercel production domain, then to the request host / localhost.
# NEXT_PUBLIC_SITE_URL="https://maison-gravure.ro"

# Stripe — card-only Checkout. Leave empty to develop with the payment simulation.
STRIPE_SECRET_KEY=""
# Signing secret of the /api/stripe/webhook endpoint (`stripe listen` prints one for local testing)
STRIPE_WEBHOOK_SECRET=""

# Development payment simulation: always on under `next dev`; set to "true" to allow it under `next start`.
# Ignored whenever STRIPE_SECRET_KEY is a live key.
# PAYMENT_SIMULATION="true"

# Owner-only admin portal (/admin). Generate the hash and secret with:
#   npm run admin:credentials -- "o parolă de cel puțin 12 caractere"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
AUTH_SECRET=""
# Canonical origin for Auth.js behind a proxy (optional; the request host is trusted otherwise)
# AUTH_URL="https://maison-gravure.ro"

# Transactional e-mail via Resend (password reset links for customer accounts).
# EMAIL_FROM must use a domain verified in Resend. Without these, reset links are shown on screen under
# `next dev` only; in production the reset form explains that e-mail is not active yet.
RESEND_API_KEY=""
EMAIL_FROM=""
